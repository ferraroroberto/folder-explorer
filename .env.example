# The bearer token a sign-in hands to other devices (remote_access on). Written by
# scripts/gen_token.py; never edit by hand, never commit the real .env. The password
# itself is a hash in config/app_password.json (python -m src.password set); a
# FOLDER_EXPLORER_PASSWORD line left from before still signs in until that runs.
FOLDER_EXPLORER_TOKEN=

# Optional: a Telegram alert when someone guesses wrong passwords (3 in a row from
# one device). Bot token, and the id of the "coding alerts" chat. Leave both empty
# to log the attempt only.
FOLDER_EXPLORER_TELEGRAM_BOT_TOKEN=
FOLDER_EXPLORER_TELEGRAM_ALERT_CHAT_ID=
